# ============================================================================
# Variables del backend (FastAPI). Copia este archivo a `.env` y ajusta lo necesario.
# Los valores activos son los de uso local. Las variables comentadas son opcionales
# o solo para la nube. Nunca subas `.env` al repositorio (ya está en .gitignore).
# ============================================================================

# Autenticación.
#   none     = uso local sin login (todo pertenece al usuario "local").
#   supabase = exige un JWT de Supabase (login con Google).
AUTH_MODE=none

# --- Solo con AUTH_MODE=supabase -------------------------------------------
# URL del proyecto de Supabase.
# SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Solo si el proyecto usa el secreto HS256 legacy. Si se omite, el JWT se valida con las llaves JWKS.
# SUPABASE_JWT_SECRET=
# Audiencia esperada en el JWT (por defecto "authenticated").
# SUPABASE_JWT_AUDIENCE=authenticated

# Dónde se guardan las credenciales de YouTube Music de cada usuario.
#   file     = archivo por usuario dentro de DATA_DIR (uso local).
#   supabase = tabla cifrada en Supabase (deploy en la nube).
CREDENTIAL_STORE=file

# --- Solo con CREDENTIAL_STORE=supabase ------------------------------------
# Clave secreta del proyecto de Supabase. Solo va en el backend, nunca en el frontend.
# SUPABASE_SERVICE_KEY=
# Clave Fernet para cifrar las credenciales. Generar con:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# CREDENTIALS_ENCRYPTION_KEY=

# --- Modo simple: "Conectar con Google" (YouTube Data API) -----------------
# El mismo cliente OAuth de Google Cloud que configuraste en Supabase (Authentication → Google).
# Sin estas variables solo está disponible el modo avanzado (cURL).
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# Carpeta de datos locales (credenciales por usuario cuando CREDENTIAL_STORE=file).
DATA_DIR=data

# Orígenes permitidos por CORS, separados por comas. Con el frontend servido por la misma app
# (contenedor) no hace falta; con GitHub Pages u otro dominio, agrega su origen.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Carpeta con el frontend compilado. Si contiene index.html, la API lo sirve en /.
FRONTEND_DIST=frontend/dist

# Procesamiento de playlists.
# Canciones por lote antes de hacer una pausa.
BATCH_SIZE=50
# Segundos de pausa entre lotes.
BATCH_DELAY_SECONDS=3
# Jobs que se ejecutan en paralelo.
JOB_WORKERS=2
# Máximo de canciones por job. Si la fuente trae más, la API responde 422.
MAX_SONGS_PER_JOB=1000
# Idioma de las respuestas de YouTube Music (por ejemplo: en, es).
YTMUSIC_LANGUAGE=en

# Puerto de escucha. Lo usa el CMD del Dockerfile cuando el PaaS lo inyecta; la app no lo lee directamente.
# PORT=8000
