# Copia este archivo a ".env" (o ".env.local") y ajusta lo que necesites.
# Todas las variables son opcionales. Se leen al compilar/arrancar Vite.

# URL del backend FastAPI. Vacío = mismo origen (la API sirve el frontend compilado,
# o en desarrollo el proxy de Vite reenvía /api a http://localhost:8000).
# Ejemplo si publicas solo el frontend: https://mi-api.onrender.com
VITE_API_BASE_URL=

# Ruta base donde se publica el frontend. Por defecto "/".
# Para GitHub Pages: /automated-ytmusic-playlist-creator/
VITE_BASE=/

# Solo desarrollo: destino del proxy de /api (por defecto http://localhost:8000).
# VITE_DEV_PROXY_TARGET=http://localhost:8000

# Login con Supabase + Google. Si defines AMBAS variables, la app pide iniciar sesión
# y envía "Authorization: Bearer <access_token>" en cada petición. Si no, funciona en
# modo local sin login (el backend debe tener AUTH_MODE=none).
# La anon key es pública por diseño; nunca pongas aquí la service key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
